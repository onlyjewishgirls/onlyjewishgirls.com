# Copy to .env.local for development. Everything has a sensible dev default.

# Exact origin the site is served from (scheme + host + port, no trailing slash).
# Passkeys and the CSRF check are bound to it, so open the site at exactly this URL.
APP_ORIGIN=http://localhost:3000

# WebAuthn relying-party ID. Defaults to APP_ORIGIN's hostname.
# In production use the registrable domain, e.g. onlyjewishgirls.com.
# WEBAUTHN_RP_ID=localhost

# 32-byte key (base64 or hex) that encrypts authenticator-app secrets at rest.
# Required in production: openssl rand -base64 32
# In development one is generated into .data/app-secret automatically.
# APP_SECRET=

# Where the SQLite database lives (default: ./.data/app.db). Must be on a persistent disk.
# DATA_DIR=.data
# DATABASE_PATH=.data/app.db

# Number of proxies in front of the app (load balancer, CDN). Used to read the
# real client IP for rate limiting. 1 = a single nginx/Caddy/Vercel/Fly hop.
# TRUSTED_PROXY_HOPS=1
