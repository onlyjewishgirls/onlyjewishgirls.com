{
  "name": "onlyjewishgirls",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs",
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/ensure-dev-vars.mjs && wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dictionary": "UPDATE_DICTIONARY=1 vitest run tests/unit/dictionary.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hebcal/core": "^6.11.0",
    "@opennextjs/cloudflare": "^1.20.7",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "libphonenumber-js": "^1.13.14",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "wordlist-english": "^1.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
