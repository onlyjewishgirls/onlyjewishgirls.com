{
  // Compiles node.mts against gate.d.mts and gate-node.d.mts as a Node-only
  // project: no DOM lib, only @types/node, and skipLibCheck off.
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "files": ["node.mts"]
}
