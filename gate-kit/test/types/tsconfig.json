{
  // Compiles worker.ts against gate.d.mts with KidMonitor's strictest options.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "files": ["worker.ts"]
}
