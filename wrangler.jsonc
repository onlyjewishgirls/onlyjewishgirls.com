{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds deploys this repo to.
  "name": "onlyjewishgirlsdotcom",
  // worker.ts runs the CAPTCHA wall (PORTAL-STANDARD §10, gate-kit/) and then hands the request to the
  // OpenNext worker (.open-next/worker.js) that the build generates; wrangler bundles the two together.
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Builds the app before local `wrangler dev` / `wrangler deploy`. Workers Builds
  // ignores this; its dashboard Build command runs `npx opennextjs-cloudflare build`.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Every path, every method, runs the Worker first, so no file (_next/static, images, favicon,
    // robots.txt) is ever served around the CAPTCHA wall. OpenNext then serves these files itself,
    // after the wall (its asset resolver is on whenever this is true).
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onlyjewishgirls",
      "database_id": "5ac84961-1003-40ed-948e-e641431d187d"
    }
  ],
  // Preview deployments (`wrangler preview`, run by Workers Builds for pull
  // requests) get their own database, so testing never touches real accounts.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "onlyjewishgirls-preview",
        "database_id": "148344fe-d550-40be-abc5-da0f447cc762"
      }
    ]
  },
  // EMAIL_FROM and other plain variables are managed in the dashboard. Without this,
  // every `wrangler deploy` deletes them (secrets are always kept).
  "keep_vars": true,
  // Mail (PORTAL-STANDARD §8): Plunk (PLUNK_API_KEY secret) is the primary; Resend (EMAIL_API_KEY) is
  // the fallback when both are set. PLUNK_API_KEY alone is a complete set-up (EMAIL_FROM defaults to
  // no-reply@onlyjewishgirls.com). EMAIL_PRIMARY "resend" would put Resend first.
  // ALERTS_EMAIL_FROM / ALERTS_EMAIL_TO: where security alert emails come from and go to
  // (PORTAL-STANDARD §6; src/server/alerts.ts). The sender must be on a domain verified in Resend/Plunk.
  // CAPTCHA wall (PORTAL-STANDARD §10): TURNSTILE_SITE_KEY goes here once the owner has created the
  // Turnstile widget (Managed; hostnames onlyjewishgirls.com, www.onlyjewishgirls.com and the
  // workers.dev ones in use), e.g. "TURNSTILE_SITE_KEY": "0x4AAAA...". It is left out until then on
  // purpose: an empty value here would replace a key set in the dashboard. The secret is
  // TURNSTILE_SECRET_KEY (`wrangler secret put TURNSTILE_SECRET_KEY`), never a var. Until both exist
  // every request gets a 503 (fail closed). GATE_MODE "off" (dashboard, plain variable) is the
  // break-glass switch.
  "vars": {
    "EMAIL_PRIMARY": "plunk",
    "ALERTS_EMAIL_FROM": "securityalerts@onlyjewishgirls.com",
    "ALERTS_EMAIL_TO": "soc@onlyjewishgirls.com"
  },
  "observability": {
    "enabled": true
  }
}
