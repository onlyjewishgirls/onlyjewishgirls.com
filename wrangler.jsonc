{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds deploys this repo to.
  "name": "onlyjewishgirlsdotcom",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Runs before `wrangler deploy`, `wrangler versions upload` and `wrangler dev`,
  // so Workers Builds' default deploy command builds the Next.js app first.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Used by OpenNext for caching; must name this Worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "onlyjewishgirlsdotcom"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onlyjewishgirls",
      "database_id": "5ac84961-1003-40ed-948e-e641431d187d"
    }
  ],
  "observability": {
    "enabled": true
  }
}
