{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds deploys this repo to.
  "name": "onlyjewishgirlsdotcom",
  // worker.ts runs the CAPTCHA wall (PORTAL-STANDARD §10, gate-kit/) and then hands the request to the
  // OpenNext worker (.open-next/worker.js) that the build generates; wrangler bundles the two together.
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Builds the app before local `wrangler dev` / `wrangler deploy`. Workers Builds
  // ignores this; its dashboard Build command runs `npx opennextjs-cloudflare build`.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Every path, every method, runs the Worker first, so no file (_next/static, images, favicon,
    // robots.txt) is ever served around the CAPTCHA wall. OpenNext then serves these files itself,
    // after the wall (its asset resolver is on whenever this is true).
    "run_worker_first": true
  },
  // Production is served on the onlyjewishgirls.com custom domain (set in the dashboard), so both
  // workers.dev hosts are off:
  // - workers_dev: onlyjewishgirlsdotcom.<account>.workers.dev, an extra public copy of production.
  // - preview_urls: <version>-onlyjewishgirlsdotcom.<account>.workers.dev and the per-branch aliases.
  //   This is per Worker, so it also stops every OLDER version's preview from being served. Those
  //   were built before the CAPTCHA wall and serve the whole app without it (PORTAL-STANDARD §10).
  //   It takes effect on the next deploy; the dashboard toggle (Settings → Domains & Routes →
  //   Preview URLs → Disable) takes effect at once. keep_vars doesn't cover either setting: the
  //   values here are applied on every deploy.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onlyjewishgirls",
      "database_id": "5ac84961-1003-40ed-948e-e641431d187d"
    }
  ],
  // Preview builds (Workers Builds, for pull requests; no preview URL while preview_urls is false)
  // get their own database, so testing never touches real accounts.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "onlyjewishgirls-preview",
        "database_id": "148344fe-d550-40be-abc5-da0f447cc762"
      }
    ]
  },
  // EMAIL_FROM and other plain variables are managed in the dashboard. Without this,
  // every `wrangler deploy` deletes them (secrets are always kept).
  "keep_vars": true,
  // Mail (PORTAL-STANDARD §8): Plunk (PLUNK_API_KEY secret) is the only provider, with no fallback.
  // PLUNK_API_KEY alone is a complete set-up (EMAIL_FROM defaults to no-reply@onlyjewishgirls.com).
  // ALERTS_EMAIL_FROM / ALERTS_EMAIL_TO: where security alert emails come from and go to
  // (PORTAL-STANDARD §6; src/server/alerts.ts). The sender must be on a domain verified in Plunk.
  // CAPTCHA wall (PORTAL-STANDARD §10): TURNSTILE_SITE_KEY goes here once the owner has created the
  // Turnstile widget (Managed; hostnames onlyjewishgirls.com and www.onlyjewishgirls.com if served;
  // the workers.dev hosts are off), e.g. "TURNSTILE_SITE_KEY": "0x4AAAA...". It is left out until then on
  // purpose: an empty value here would replace a key set in the dashboard. The secret is
  // TURNSTILE_SECRET_KEY (`wrangler secret put TURNSTILE_SECRET_KEY`), never a var. Until both exist
  // every request gets a 503 (fail closed). GATE_MODE "off" (dashboard, plain variable) is the
  // break-glass switch.
  "vars": {
    "ALERTS_EMAIL_FROM": "securityalerts@onlyjewishgirls.com",
    "ALERTS_EMAIL_TO": "soc@onlyjewishgirls.com"
  },
  "observability": {
    // Workers Logs: every request, console output and uncaught exception,
    // searchable under the Worker's Observability tab in the dashboard.
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  }
}
